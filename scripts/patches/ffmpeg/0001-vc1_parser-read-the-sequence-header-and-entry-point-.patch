Subject: [PATCH] vc1_parser: read the sequence header and entry point from
 extradata

libavformat closes and reopens a stream's parser when it seeks. A VC-1
stream whose sequence header and entry point live only in the codec
extradata (Matroska CodecPrivate, for one) then parses the frame headers
after the seek against an empty context, and reads them at the wrong bit
offsets. The decoder already reads both headers from extradata at init;
this makes the parser do the same before its first packet.
---
 libavcodec/vc1_parser.c | 47 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/libavcodec/vc1_parser.c b/libavcodec/vc1_parser.c
index 595d066..037fc9a 100644
--- a/libavcodec/vc1_parser.c
+++ b/libavcodec/vc1_parser.c
@@ -27,6 +27,7 @@
 
 #include "libavutil/attributes.h"
 #include "libavutil/avassert.h"
+#include "libavutil/mem.h"
 #include "parser.h"
 #include "parser_internal.h"
 #include "vc1.h"
@@ -58,8 +59,49 @@ typedef struct VC1ParseContext {
     uint8_t unesc_buffer[UNESCAPED_LIMIT];
     size_t unesc_index;
     VC1ParseSearchState search_state;
+    int extradata_parsed;
 } VC1ParseContext;
 
+static int vc1_find_marker(const uint8_t *buf, int from, int size)
+{
+    for (int i = from; i + 4 <= size; i++)
+        if (buf[i] == 0 && buf[i + 1] == 0 && buf[i + 2] == 1)
+            return i;
+    return size;
+}
+
+/* Reads the sequence header and entry point from the codec extradata.
+ * libavformat reopens the parser after a seek, and a stream that keeps
+ * these headers only in its extradata would otherwise parse the next
+ * frame headers against an empty context. */
+static void vc1_parse_extradata(VC1ParseContext *vpc, AVCodecContext *avctx)
+{
+    const uint8_t *buf = avctx->extradata;
+    int size = avctx->extradata_size;
+    uint8_t *unesc;
+
+    if (!buf || size < 4)
+        return;
+    unesc = av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!unesc)
+        return;
+    vpc->v.s.avctx = avctx;
+    for (int start = vc1_find_marker(buf, 0, size); start < size;) {
+        int next = vc1_find_marker(buf, start + 4, size);
+        int len = vpc->v.vc1dsp.vc1_unescape_buffer(buf + start + 4, next - start - 4, unesc);
+        GetBitContext gb;
+
+        if (len > 0 && init_get_bits8(&gb, unesc, len) >= 0) {
+            if (buf[start + 3] == (VC1_CODE_SEQHDR & 0xFF))
+                ff_vc1_decode_sequence_header(avctx, &vpc->v, &gb);
+            else if (buf[start + 3] == (VC1_CODE_ENTRYPOINT & 0xFF))
+                ff_vc1_decode_entry_point(avctx, &vpc->v, &gb);
+        }
+        start = next;
+    }
+    av_free(unesc);
+}
+
 static void vc1_extract_header(AVCodecParserContext *s, AVCodecContext *avctx,
                                const uint8_t *buf, int buf_size)
 {
@@ -142,6 +184,11 @@ static int vc1_parse(AVCodecParserContext *s,
     int next = END_NOT_FOUND;
     int i = vpc->bytes_to_skip;
 
+    if (!vpc->extradata_parsed) {
+        vpc->extradata_parsed = 1;
+        vc1_parse_extradata(vpc, avctx);
+    }
+
     if (pic_found && buf_size == 0) {
         /* EOF considered as end of frame */
         memset(unesc_buffer + unesc_index, 0, UNESCAPED_THRESHOLD - unesc_index);
